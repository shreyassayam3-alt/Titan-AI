# Copy this file to .env for local development. Never commit real secrets.

# Runtime environment (development, test, staging, production)
TITAN_ENV=development

# Web server settings
TITAN_WEB_HOST=127.0.0.1
TITAN_WEB_PORT=8000

# Real LLM credentials. Add whichever providers you want to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Search providers for live research (optional)
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
